# ViceSunshine standalone — copy to .env (local) or set in Railway Variables.
# NEVER commit a real key. No secrets are stored in this repo.

# Required for sign-up / sign-in / password-reset code emails.
# Create a Resend API key (https://resend.com/api-keys) after verifying
# vicesunshine.com as a sending domain in Resend. See README.md.
RESEND_API_KEY=

# From address for code emails. Must be on the verified domain.
EMAIL_FROM=ViceSunshine <noreply@vicesunshine.com>

# Port the web server listens on. Railway sets PORT automatically.
PORT=3000

# Data directory (defaults to the repo root, where app.db and blobs/ live).
# On Railway this is the mounted volume path, e.g. /data.
SPACE_DIR=.

# Worker only: base URL of the web service it calls.
WORKER_BASE_URL=http://localhost:3000

# --- Automatic updates (all optional — without them the site still
# runs, but the refreshers add nothing new; see README.md) ---
# Web search for new news / feed media / clips / database entries /
# bugs / Easter eggs. Brave first, Tavily as fallback. Free tiers:
# Brave 2,000 searches/month (https://brave.com/search/api),
# Tavily 1,000/month (https://tavily.com). No card needed for either.
BRAVE_API_KEY=
TAVILY_API_KEY=
# Monthly search budget guard (counts searches, pauses refreshers
# when used up instead of hammering a dead quota). Defaults: 1,800
# with a Brave key, 900 with Tavily only. At Muse's hourly cadence
# the worker uses ~500 searches/day, so a free Brave key lasts
# ~4 days a month — see README for the maths and how to stretch it.
SEARCH_MONTHLY_BUDGET=

# AI for Ask Vice's full answers, Database / bug / Easter egg
# extraction from search results, and real image moderation.
# Any OpenAI-compatible API works. Free option: Google AI Studio
# (https://aistudio.google.com) — create a free Gemini API key, then:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash
# Or use OpenAI itself (paid): leave OPENAI_BASE_URL unset and set
# OPENAI_MODEL=gpt-4o-mini. Without this key Ask Vice answers from
# the site's own data, Database auto-adds and egg discovery pause,
# and image moderation stays OFF (text screening still runs).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
